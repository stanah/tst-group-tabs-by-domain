{
  "manifest_version": 2,
  "name": "TST Group Tabs by Domain",
  "version": "0.0.5",
  "description": "Groups Tree Style Tabs by Domain with LLM-powered auto grouping",
  "browser_specific_settings": {
    "gecko": {
      "id": "tst_group_tabs_by_domain@stanah"
    }
  },
  "browser_action": {},
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "background": {
    "page": "bg.html"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "permissions": ["tabs", "contextMenus", "<all_urls>", "storage", "notifications"]
}
